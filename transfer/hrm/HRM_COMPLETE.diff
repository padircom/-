+       * ورود به کارگاه که سه بُعد را با «و» ترکیب می‌کند. */
+      hse: {
+        cleared: hse.cleared,
+        siteEntryOk: hse.siteEntryOk,
+        blockersFa: hse.blockersFa,
+        warningsFa: hse.warningsFa,
