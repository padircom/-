+/** رویدادی که تحقیق رسمی لازم دارد — پایین‌تر از این، بررسی سرپرست کافی است. */
+export const INVESTIGATION_REQUIRED_TYPES: IncidentType[] = [
+  "lost_time", "fatality", "environmental",
+];
