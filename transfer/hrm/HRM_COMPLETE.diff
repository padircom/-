+  assert.ok(s.notesFa.some((n) => n.includes("هیچ عددی به مالی نمی‌رسد")));
+});
+
+test("صورت‌وضعیت باطل در ناخالص تأییدشده نمی‌آید", () => {
+  const s = contractFinSummary({
+    contract: CONTRACT,
+    ipcs: [IPC(), IPC({ Id: "x", SerialNo: 2, Status: "cancelled" })],
+    postings: [P()],
