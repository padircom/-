+
+/* ═══════════ ۵. بودجه ═══════════ */
+
+test("ثبتی که از بودجه رد می‌کند بدون تأیید صریح انجام نمی‌شود", async () => {
+  const s = await scenario({ budget: 1000, cumQty: 40 });
