+/** رکوردهای وابستهٔ یک رویداد. */
+async function incidentBundle(r, incident) {
+  const [persons, invList, actions] = await Promise.all([
+    r.list("InjuredPerson", { where: [{ column: "IncidentId", op: "eq", value: incident.Id }], limit: 200 }),
