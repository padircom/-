+      return cntBad(req, res, "E-CNT-GRT-NOT-FOUND", "ضمانت‌نامه یافت نشد", 404);
+    }
+
+    const verdict = canActOnGuarantee({ row, action: "extend", newExpiry: b.newExpiry });
