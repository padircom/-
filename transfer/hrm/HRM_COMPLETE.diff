+      </div>
+
+      {/* محتوا */}
+      <div className="min-h-0 flex-1 overflow-y-auto pe-1">
+        {tab === "jsa" && <JsaTab f={jsa} rtl={rtl} />}
+        {tab === "permit" && <PermitTab f={permits} rtl={rtl} onAct={act} />}
+        {tab === "incident" && <IncidentTab f={incidents} rtl={rtl} onAct={act} />}
