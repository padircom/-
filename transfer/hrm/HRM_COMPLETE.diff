+          { name: "docNo", fa: "شمارهٔ مدرک", kind: "text", required: true, placeholder: "PI-ISO-021" },
+          { name: "titleFa", fa: "عنوان مدرک", kind: "text", required: true, span2: true },
+          { name: "discipline", fa: "دیسیپلین", kind: "select", required: true,
