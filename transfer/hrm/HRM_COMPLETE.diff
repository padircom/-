+test("گازسنجی کهنه معتبر نیست", () => {
+  const now = new Date("2026-09-09T12:00:00Z");
+  const tests = [{ Id: "g1", PermitId: "p1", TestedAt: "2026-09-09T08:00:00Z", LelPct: 0, OxygenPct: 20.9, H2sPpm: 0, CoPpm: 0 }];
