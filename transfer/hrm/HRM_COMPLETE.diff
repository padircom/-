+  assert.ok(item);
+  const again = await post(`/api/cnt/boq?projectId=${PROJECT}`, {
+    contractId: c.Id, itemNo: "070707", titleFa: "دوباره", pricingBasis: "unit_price",
+    unit: "متر", contractQty: 1, unitRate: 1,
