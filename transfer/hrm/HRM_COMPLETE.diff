+      NewActivityId: b.newActivityId ?? null, NewCbsId: b.newCbsId ?? null,
+      ReasonCode: b.reasonCode ?? null, ReasonTextFa: String(b.reasonTextFa),
+      PeriodCode: periodOf(String(entry.WorkDate)),
