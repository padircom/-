+/** «—» برای مقدار غایب: صفر چاپ‌کردن یعنی ادعای دانستن. */
+function cell(v: unknown): string | number {
+  if (v == null || v === "") return "—";
+  return typeof v === "number" ? v : String(v);
+}
+
+function pct(v: unknown): string {
+  return v == null ? "—" : `${round(num(v), 1)}`;
