+/* ───────────────────────── کاتالوگ ───────────────────────── */
+
+test("کاتالوگ گزارش‌های ناوگان شش قلم یکتا دارد", () => {
+  assert.equal(EQP_REPORT_VERSION, "eqp-rpt-v1");
