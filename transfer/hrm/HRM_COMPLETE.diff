+
+test("پروانهٔ بدون ایزولاسیون allApplied نمی‌دهد", () => {
+  const r = isolationState([], "p-none");
+  assert.equal(r.total, 0);
+  assert.equal(r.allApplied, false, "صفر ایزولاسیون یعنی نامشخص نه کامل");
+  assert.equal(r.allRemoved, false);
