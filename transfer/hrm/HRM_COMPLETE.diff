+
+/* ══════ هشدار پنجرهٔ سفارش ══════ */
+
+test("پنجرهٔ گذشته هشدار بحرانی می‌دهد", () => {
+  const a = procurementAlerts({ requests: [mr({ ReleaseByDate: "2026-01-01" })], asOf: NOW });
