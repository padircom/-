+    assert.ok(codes.includes(c), `کد ${c} غایب است`);
+  }
+});
+
+test("هر مدخل کاتالوگ عنوان دوزبانه، دوره و مخاطب معتبر دارد", () => {
+  const periods = ["daily", "weekly", "monthly", "quarterly", "adhoc"];
