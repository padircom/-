+
+/* ══════ درخواست خرید ══════ */
+
+test("درخواست تأییدشده پیش‌نویس خرید می‌سازد", () => {
+  const p = planPurchaseRequisitions({ requests: [mr()] });
+  assert.equal(p.drafts.length, 1);
+  assert.equal(p.drafts[0].mrCode, "MR-PR-PID-001");
