+
+test("نبود برنامه هشدار می‌دهد", () => {
+  const c = sCurve({ planned: [], actual: [{ periodCode: "1405-01", cumPct: 20 }] });
+  assert.ok(c.warningsFa.some((w) => w.includes("برنامهٔ زمانی")));
