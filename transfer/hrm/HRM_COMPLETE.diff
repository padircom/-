+
+test("آشتی پروژهٔ دیگر خالی است", async () => {
+  const r = await req(`/api/events/reconcile?projectId=${OTHER}`);
+  assert.equal(r.json.data.rows.length, 0);
+  assert.equal(r.json.data.isClean, true);
