+  const items: Json[] = reg?.items ?? [];
+  const health: Json = reg?.health ?? {};
+  const advance: Json = reg?.advance ?? {};
+
+  return (
+    <div className="space-y-3">
+      {/* ── سلامت وثیقه‌ای ── */}
