+
+/* ══════════════ ۱) جلسهٔ آموزش ══════════════ */
+
+const session = (over = {}) => ({
+  Id: "s1", ProjectId: "p1", SessionNo: "TRN-001", TitleFa: "ایمنی کار در ارتفاع",
+  CourseCode: "HSE-HGT", TrainingType: "specialist", HeldAt: "2026-06-10T08:00:00.000Z",
