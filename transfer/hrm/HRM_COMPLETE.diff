+  fracture: "شکستگی",
+  burn: "سوختگی",
+  poisoning: "مسمومیت",
+  crush: "له‌شدگی",
+  sprain: "کشیدگی و رگ‌به‌رگ",
+  eye: "آسیب چشم",
+  other: "سایر",
+};
+
+export const BODY_PARTS = [
+  "head", "eye", "hand", "arm", "leg", "foot", "torso", "back", "multiple",
+] as const;
+
+export const BODY_PART_FA: Record<string, string> = {
+  head: "سر",
+  eye: "چشم",
+  hand: "دست",
+  arm: "بازو",
+  leg: "پا",
+  foot: "کف پا",
+  torso: "تنه",
