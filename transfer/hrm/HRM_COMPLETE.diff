+    assert.ok(t, `جدول ${n} نیست`);
+    assert.equal(t.module, "d16");
+  }
+  /* SafetyTrainingRecord از قبل موجود بود و نباید دوباره ساخته شود. */
+  assert.ok(SCHEMA.find((x) => x.name === "SafetyTrainingRecord"), "جدول قدیمی حذف شده");
+});
