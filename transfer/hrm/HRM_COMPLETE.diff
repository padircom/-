+    const out = await r.upsert(
+      "HSE_AlertRule",
+      { ProjectId: projectId, RuleCode: ruleCode },
+      payload,
+      subject?.id,
+    );
+
+    res.json(cntOk(req, { item: out?.row ?? payload, mutedUntil: until }));
+  } catch (err) { next(err); }
+});
