+      columns: [
+        { key: "code", title: { fa: "کد", en: "Code" } },
+        { key: "severity", title: { fa: "شدت", en: "Severity" }, align: "center" },
+        { key: "title", title: { fa: "عنوان", en: "Title" }, weight: 2 },
+        { key: "detail", title: { fa: "شرح", en: "Detail" }, weight: 4 },
+      ],
