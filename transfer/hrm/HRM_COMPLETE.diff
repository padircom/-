+
+/* ══════════════ ۴) هشدارها ══════════════ */
+
+test("پروانهٔ منقضی بازنشده هشدار می‌سازد", async () => {
+  const r = await api("GET", `/api/hse/alerts${P}`);
+  assert.equal(r.ok, true, JSON.stringify(r));
+  assert.equal(r.data.count, 5);
