+      { column: "ProjectId", op: "eq", value: projectId },
+      { column: "Id", op: "eq", value: String(req.params.id) },
+    ]);
+    if (!row) return hrmBad(req, res, "E-HRM-SUB-NOT-FOUND", "قرارداد پیمانکاری پیدا نشد", 404);
+
