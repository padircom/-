+/* محاسبهٔ تعدیل یک صورت‌وضعیت بر مبنای کارکرد فصل‌های همان دوره. */
+app.post("/api/cnt/ipc/:id/adjustment", cntRequire("cnt.ipc.prepare"), async (req, res, next) => {
