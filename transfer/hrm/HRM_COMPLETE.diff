+            severity: "error",
+            field: "personId",
+            personId: pid,
+            messageFa: `وضعیت ${person.FullNameFa} «${PERSON_STATUS_FA[st] ?? st}» است؛ ساعت فقط برای نیروی فعال ثبت می‌شود`,
+          });
