+  /* حساب با ۵۰۰۰ شروع شد. هرچه HRM بفرستد، آن ۵۰۰۰ باید بماند. */
+  const actual = Number((await table("CostAccount")).find((a) => a.Id === "CBS-1")?.Actual ?? 0);
+  const share = Number((await table("HrmCostPosting")).find(
