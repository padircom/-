+  assert.equal(c.closed[0].consultantDays, 9);
+  assert.equal(c.avgDays, 20);
+});
+
+test("صورت‌وضعیت گیرکرده میانگین را بالا می‌برد — دام بقا", () => {
+  const c = ipcCycle({
