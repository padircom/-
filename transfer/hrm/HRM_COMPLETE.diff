+  const adds = m.statements.filter((s) => s.includes("ALTER TABLE"));
+  assert.equal(adds.length, 3);
+  for (const s of adds) assert.match(s, /IF COL_LENGTH/, "افزودن ستون باید محافظ داشته باشد");
