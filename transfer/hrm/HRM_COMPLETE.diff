+/** ثبت پروندهٔ پرسنلی. نفر تازه همیشه `candidate` است. */
+app.post("/api/hrm/people", hrmRequire("hrm.person.manage"), async (req, res, next) => {
+  try {
+    const projectId = hrmProjectOf(req, res);
+    if (!projectId) return;
