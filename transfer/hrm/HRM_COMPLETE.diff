+
+test("مقدار منفی مثل اندازه‌نگرفته رفتار می‌کند نه صفر ایمن", () => {
+  /* گازسنج معیوب مقدار منفی می‌دهد. اگر آن را صفر بخوانیم، دستگاه خراب
+   * سبزترین نتیجهٔ ممکن را تولید می‌کند — برعکس آنچه ایمنی لازم دارد. */
