+    else if (seen.has(n)) errors.push({ code: "E-COM-DUP-LINE", message: `\u0634\u0645\u0627\u0631\u0647\u0654 \u0631\u062F\u06CC\u0641 ${n} \u062A\u06A9\u0631\u0627\u0631\u06CC \u0627\u0633\u062A` });
