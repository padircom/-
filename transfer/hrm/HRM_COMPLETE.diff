+test("مقدار غیرعددی مثل ثبت‌نشده رفتار می‌کند نه صفر", () => {
+  const r = evaluateGasTest({ LelPct: "بالا", OxygenPct: 20.9, H2sPpm: 0, CoPpm: 0 });
