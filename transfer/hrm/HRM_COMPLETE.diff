+  near(toBase({ amount: 100, currency: "USD" }, { USD: 500000 }), 50000000);
+  near(toBase({ amount: 7, currency: "IRR" }, {}), 7);
+  assert.throws(() => toBase({ amount: 1, currency: "EUR" }, { USD: 1 }));
+});
+
+test("تعدیل با شاخص", () => near(escalate(1000, 100, 125), 1250));
