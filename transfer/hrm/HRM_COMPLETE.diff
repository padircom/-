+    note: { fa: "تجزیهٔ کامل TASK، TASKPRED، PROJWBS و CALENDAR با تفاوت‌گیری پیش از نوشتن", en: "Full TASK, TASKPRED, PROJWBS and CALENDAR parsing with pre-write diff" },
+  },
+  {
+    code: "CN-XLS-TPL",
