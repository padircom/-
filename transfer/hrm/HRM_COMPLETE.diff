+
+/* ══════════════════════ ۵) الزام توقف کار ══════════════════════ */
+
+test("کار بدون پروانه بدون استثنا توقف کار دارد", () => {
+  const r = stopWorkRequirement({ ViolationType: "no_ptw", Severity: "low" });
