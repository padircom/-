+                <th key={s.code} className="p-1.5 text-center" title={s.titleFa}>{s.pct}٪</th>
+              ))}
+              <th className="p-1.5 text-center">{rtl ? "پیشرفت" : "Progress"}</th>
+            </tr>
+          </thead>
+          <tbody>
+            {items.map((it) => (
+              <tr key={it.id} className="glass-row">
