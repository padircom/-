+/* ─────────────────── گزارش نگهداری ─────────────────── */
+
+const ORDERS = [
+  { Id: "w1", EquipmentId: "e1", Kind: "corrective", Priority: "critical", Status: "open", ReportedAt: "2026-09-01", Cost: 12e6, RootCause: "wear" },
