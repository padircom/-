+
+test("ارزیابی پیش‌نویس پروانه را پشتیبانی نمی‌کند", () => {
+  const r = jsaSupportsPermit(jsa(), NOW);
+  assert.equal(r.ok, false);
+  assert.ok(r.blockersFa.some((b) => b.includes("تصویب نشده")));
