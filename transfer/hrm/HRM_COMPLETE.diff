+test("پیمان با مبلغ صفر، درصد مصرف تعهد ندارد", () => {
+  const s = contractFinSummary({
+    contract: { ...CONTRACT, InitialAmount: 0, CurrentAmount: 0 }, ipcs: [], postings: [],
+  });
