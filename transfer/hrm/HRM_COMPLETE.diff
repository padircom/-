+/* انباشت سپرده از کسور یک صورت‌وضعیت به دفتر. */
+app.post("/api/cnt/retainage/accrue", cntRequire("cnt.retainage.manage"), async (req, res, next) => {
+  try {
+    const b = engBody(req);
+    const projectId = String(req.query.projectId || b.projectId || "");
