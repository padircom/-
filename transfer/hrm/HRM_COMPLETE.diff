+      precautions: created,
+      requiresGasTest: GAS_TEST_REQUIRED_PERMITS.includes(row.PermitType),
+      requiresIsolation: ISOLATION_REQUIRED_PERMITS.includes(row.PermitType),
+    }));
+  } catch (err) { next(err); }
