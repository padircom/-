+      projectId, entityName: "IntegrationEvent", entityId: String(row.Id),
+      severity: outcome.nextStatus === "abandoned" ? "warning" : "info",
+      eventType: row.EventType, result: outcome.nextStatus, attempt: outcome.attemptCount,
+    });
