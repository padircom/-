+/** فهرست ردیف‌های مبنا. */
+app.get("/api/hrm/manpower-plan", hrmRequire("hrm.analytics.view"), async (req, res, next) => {
+  try {
+    const projectId = hrmProjectOf(req, res);
+    if (!projectId) return;
