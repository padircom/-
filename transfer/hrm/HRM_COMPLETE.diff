+      CurrentAmount: dup ? Number(dup.CurrentAmount ?? initialAmount) : initialAmount,
+      CeilingPct: b.ceilingPct != null ? Number(b.ceilingPct) : 25,
+      AdvancePct: b.advancePct != null ? Number(b.advancePct) : 0,
