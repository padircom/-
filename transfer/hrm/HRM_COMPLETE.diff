+function printHtml(html: string) {
+  const w = window.open("", "_blank", "width=900,height=1200");
+  if (!w) return false;
+  w.document.open();
+  w.document.write(html);
+  w.document.close();
+  w.focus();
+  setTimeout(() => w.print(), 350);
+  return true;
