+          { name: "wbsId", fa: "شناسهٔ WBS", kind: "text", hintFa: "بدون آن، قفل IFC روی فعالیت اثر ندارد" },
+          { name: "targetIfaDate", fa: "تاریخ هدف ارسال", kind: "date" },
+          { name: "targetIfcDate", fa: "تاریخ هدف صدور", kind: "date" },
