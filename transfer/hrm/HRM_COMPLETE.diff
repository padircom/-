+
+/* ══════════════ اسکیما ══════════════ */
+
+test("چهار جدول JSA در اسکیما هستند", () => {
+  for (const n of ["HSE_RiskAssessment", "JSA_JobStep", "JSA_Hazard", "JSA_Control"]) {
+    const t = SCHEMA.find((x) => x.name === n);
+    assert.ok(t, `جدول ${n} نیست`);
+    assert.equal(t.module, "d16");
+  }
