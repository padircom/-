+/* تست‌های تحویلی ۱۱ و ۱۲ ماژول ماشین‌آلات: کاتالوگ گزارش، شش سازنده،
+ * دروازهٔ انتشار و سازگاری خروجی با سریال‌سازهای موتور A4 سه‌لوگو. */
+import test from "node:test";
+import assert from "node:assert/strict";
+
+import {
