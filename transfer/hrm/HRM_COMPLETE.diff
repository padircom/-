+/** یک رویداد با بار کامل. */
+app.get("/api/events/outbox/:id", hrmRequire("core.event.view"), async (req, res, next) => {
+  try {
+    const projectId = hrmProjectOf(req, res);
+    if (!projectId) return;
+    const r = await repo();
