+  return (
+    <label className="block">
+      <span className="mb-1 block text-[8.5px] font-extralight tx3">
+        {spec.fa}
+        {spec.required && <span className="text-rose-300"> *</span>}
+      </span>
+      {spec.kind === "select" ? (
+        <select className={base} value={value} onChange={(e) => onChange(e.target.value)}>
