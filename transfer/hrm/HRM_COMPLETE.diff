+    assert.equal(r.json.data.rows[0].status, "undelivered");
+    assert.equal(r.json.data.isClean, false);
+  }
+});
+
+test("رویداد تحویل‌نشده جدا از منطبق دیده می‌شود", async () => {
+  const r = await req(`/api/events/reconcile?projectId=${PROJECT}`);
