+    res.json(hrmOk(req, {
+      id: person.Id,
+      personnelNo: person.PersonnelNo,
+      fullNameFa: person.FullNameFa,
+      nameEn: person.NameEn ?? null,
+      /* کد ملی و شمارهٔ تماس پشت `hrm.personal.view` می‌مانند: سرپرست
