+    /* قفل پس از بسته‌شدن تخلف بازمحاسبه می‌شود — اگر تخلف دیگری هنوز
+     * همان فعالیت را می‌گیرد، قفل باز نمی‌شود. */
+    const lock = await syncActivityLock(r, violation.ProjectId, violation.ActivityId, subject?.id);
