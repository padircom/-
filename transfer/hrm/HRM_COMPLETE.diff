+test("قفل اعمال‌شده بدون شمارهٔ فیزیکی ایراد است", () => {
+  const r = isolationState(
+    [{ Id: "x", PermitId: "p9", IsolationNo: 1, IsolationType: "electrical", PointTagFa: "تابلو", Status: "applied" }],
+    "p9",
