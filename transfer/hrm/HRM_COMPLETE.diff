+
+      {/* ── پیش‌پرداخت ── */}
+      <Panel
+        title="دفتر پیش‌پرداخت"
+        note="ماندهٔ بازیافت‌نشده از پرداخت منهای بازیافت محاسبه می‌شود، نه از ستون ذخیره‌شده"
+      >
