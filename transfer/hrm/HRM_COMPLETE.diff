+        {children}
+      </div>
+    </div>
+  );
+}
+
+type Tone = "danger" | "warn" | "ok" | "mute";
+
+const toneColor = (t?: Tone) =>
+  t === "danger" ? "#DC2626" : t === "warn" ? "#D97706" : t === "ok" ? "#059669" : undefined;
