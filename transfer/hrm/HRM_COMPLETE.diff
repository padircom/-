+}
+
+/** فهرست موانع/هشدارها — همان متن موتور، بدون بازنویسی. */
+function Notes({ items, tone = "danger" }: { items?: string[] | null; tone?: "danger" | "warn" }) {
+  if (!items?.length) return null;
