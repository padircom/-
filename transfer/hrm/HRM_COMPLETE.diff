+async function fetchJson<T>(url: string): Promise<T | null> {
+  try {
+    const res = await fetch(url);
+    if (!res.headers.get("content-type")?.includes("application/json")) return null;
+    const body = await res.json();
+    return (body?.data ?? body) as T;
+  } catch {
+    return null;
+  }
