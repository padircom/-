+/* ══════════════ ۸) اعتبارسنجی کسر ══════════════ */
+
+test("کسر معتبر پذیرفته می‌شود", () => {
+  const v = validateBackToBack({
+    sourceModule: "fin_material", descriptionFa: "بتن تحویلی کارگاه مرکزی",
