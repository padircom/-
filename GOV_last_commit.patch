+  govTrail = appendTrail(govTrail, `APPROVE:${task.id}:${req.body?.actor || "system"}`);
+  res.json(govOk(req, { entry: govTrail[govTrail.length - 1] }));
+});
+
+app.get("/api/gov/connectors", (req, res) => {
